{
  "name": "dsh-reply-forge-v3",
  "version": "3.4.2",
  "type": "module",
  "description": "DSH 桌面端插件 v3：直接写活会话（message projection），改完立即被大模型采信，不用重启；也可显式只落盘（重启后生效）",
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    ".dsh-plugin/index.mjs",
    ".dsh-plugin/client.js",
    ".dsh-plugin/server/",
    "src/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "reply"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "lint": "node scripts/lint-flat.mjs",
    "verify-host": "node scripts/verify-host.mjs",
    "build:esbuild": "node scripts/build-client-esbuild.mjs",
    "release": "node scripts/build-release.mjs v3.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinggod899/dsh-reply-forge-v3.git"
  },
  "homepage": "https://github.com/kinggod899/dsh-reply-forge-v3#readme",
  "publishConfig": {
    "access": "public"
  }
}
